# Modèle à copier dans web/.env.local (jamais commité), puis à remplir.
# Seules les variables NEXT_PUBLIC_ sont lisibles dans le navigateur : n'y mettez JAMAIS de clé secrète.

# Adresse du serveur S'STACK (dossier server/)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase : URL du projet et clé PUBLIQUE (publishable / anon) uniquement
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
