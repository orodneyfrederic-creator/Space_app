# Modèle à copier dans web/.env.local (jamais commité).
# Seules les variables NEXT_PUBLIC_ sont lisibles dans le navigateur : n'y mettez JAMAIS de clé secrète.

# Adresse du serveur S'STACK (dossier server/)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Adresse publique du site (pour l'image de partage sur les réseaux). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
