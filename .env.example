# Modèle à copier dans server/.env, puis à remplir avec vos vraies valeurs.
# Ne jamais mettre de vraie clé dans ce fichier : il est envoyé sur GitHub.

TELEGRAM_BOT_TOKEN=

SUPABASE_URL=
# Clé publique (anon / publishable)
SUPABASE_ANON_KEY=
# Clé secrète (service_role / secret) : côté serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=

# LLM principal : Groq (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Transcription vocale : Whisper de Groq
GROQ_STT_MODEL=whisper-large-v3

# LLM de secours, utilisé si Groq renvoie 429 ou dépasse le délai (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

PORT=3001
# Adresse du front-end autorisée à appeler l'API (CORS)
FRONTEND_URL=http://localhost:3000
